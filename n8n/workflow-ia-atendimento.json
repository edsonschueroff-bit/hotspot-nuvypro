    {
      "parameters": {
        "jsCode": "let dadosFinal;\ntry {\n  dadosFinal = $('Unificar Análise Vision').item.json;\n  if (dadosFinal) return [{ json: dadosFinal }];\n} catch(e) {}\ntry {\n  dadosFinal = $('Unificar Transcrição Áudio').item.json;\n  if (dadosFinal) return [{ json: dadosFinal }];\n} catch(e) {}\ndadosFinal = $('Extrair Dados da Mensagem').item.json;\nreturn [{ json: dadosFinal }];"
      },
