    {
      "parameters": {
        "jsCode": "const body = $input.first().json.body || $input.first().json;\nconst data = body.data || body;\nconst message = data.message || {};\n\n// 1. Anti-Loop Crítico: Ignora mensagens enviadas pelo próprio bot\nif (data.key?.fromMe === true || body.fromMe === true) {\n  throw new Error('Mensagem ignorada: enviada pelo próprio bot (fromMe)');\n}\n\nconst phone = (data.key?.remoteJid || body.remoteJid || '').replace('@s.whatsapp.net', '').replace('@c.us', '');\nconst pushName = data.pushName || body.pushName || 'Cliente';\nconst messageId = data.key?.id || body.messageId || '';\nconst empresaId = data.empresa_id || body.empresa_id || 1;\n\n// 2. Detecta tipo de mensagem recebida\nconst isAudio = !!(message.audioMessage || message.pttMessage);\nconst isImage = !!(message.imageMessage);\nconst isDocument = !!(message.documentMessage);\nconst isMedia = isImage || isDocument;\n\n// 3. Captura base64 e mimetype de imagem/documento\nconst mediaBase64 = (isImage || isDocument) ? (message.base64 || data.base64 || body.base64 || '') : '';\nconst mediaMimeType = message.imageMessage?.mimetype ||\n                     message.documentMessage?.mimetype || 'image/jpeg';\nconst mediaCaption = message.imageMessage?.caption ||\n                     message.documentMessage?.caption || '';\nconst mediaFileName = message.documentMessage?.fileName || '';\n\n// 4. Captura base64 de áudio\nconst audioBase64 = isAudio ? (message.base64 || data.base64 || body.base64 || message.audioMessage?.base64 || '') : '';\nconst audioUrl = message.audioMessage?.url || message.pttMessage?.url || '';\n\nconst text = message.conversation || message.extendedTextMessage?.text || body.text || '';\n\nif (!phone || phone.includes('-')) {\n  throw new Error('Mensagem ignorada: vazia ou de grupo');\n}\n\nreturn [{\n  json: {\n    phone,\n    text,\n    messageId,\n    pushName,\n    empresaId,\n    isAudio,\n    isImage,\n    isDocument,\n    isMedia,\n    audioUrl,\n    audioBase64,\n    mediaBase64,\n    mediaMimeType,\n    mediaCaption,\n    mediaFileName\n  }\n}];"
      },
