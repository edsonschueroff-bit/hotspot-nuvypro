    {
      "parameters": {
        "jsCode": "const visionData = $input.first().json;\nconst dadosOriginais = $('Extrair Dados da Mensagem').item.json;\nconst rawContent = visionData?.choices?.[0]?.message?.content || '';\n\nconst textoEnriquecido = `[CLIENTE ENVIOU ${dadosOriginais.isDocument ? 'DOCUMENTO' : 'IMAGEM'}]\\nAnálise Visual: ${rawContent}${dadosOriginais.mediaCaption ? `\\nLegenda da imagem: \"${dadosOriginais.mediaCaption}\"` : ''}`;\n\nreturn [{\n  json: {\n    ...dadosOriginais,\n    text: textoEnriquecido,\n    isMedia: true\n  }\n}];"
      },
