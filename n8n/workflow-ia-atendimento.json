    {
      "parameters": {
        "jsCode": "const dados = $input.first().json;\nconst mediaBase64 = dados.mediaBase64 || '';\nconst mediaMimeType = dados.mediaMimeType || 'image/jpeg';\nconst mediaCaption = dados.mediaCaption || '';\nconst mediaFileName = dados.mediaFileName || '';\nconst isDocument = dados.isDocument;\n\nconst userContent = [\n  { type: 'image_url', image_url: { url: `data:${mediaMimeType};base64,${mediaBase64}`, detail: 'high' } },\n  { type: 'text', text: mediaCaption ? `O cliente enviou esta imagem com a legenda: \"${mediaCaption}\". Analise e descreva os pontos relevantes (comprovante PIX, tela de login do Wi-Fi, dúvida técnica ou produto).` : 'Analise esta imagem enviada pelo cliente e resuma o conteúdo de forma objetiva.' }\n];\n\nconst messages = [\n  {\n    role: 'system',\n    content: 'Você é um assistente de atendimento analisando imagens enviadas por clientes (comprovantes PIX, telas de conexão Wi-Fi, documentos ou fotos). Seja técnico, conciso e responda em português.'\n  },\n  { role: 'user', content: userContent }\n];\n\nreturn [{ json: { ...dados, visionBodyStr: JSON.stringify({ model: 'gpt-4o-mini', max_tokens: 300, messages }) } }];"
      },
